# Optional; set a comma-separated list for additional frontend origins.
# The local React dev server is already allowed by the API.
# Comma-separated production frontend origins, e.g. https://your-app.vercel.app
KG_CORS_ORIGINS=

# Gemini multilingual extraction and grounded Q&A (keep the key server-side only)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
